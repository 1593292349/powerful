{
	"private":"true",
	"type":"module",
	"name":"powerful-monorepo",
	"version":"1.0.0",
	"description":"前端工具集",
	"scripts":{
		"test":"pnpm -r --filter=\"./packages/**\" run test",
		"build": "pnpm -r --filter=\"./packages/**\" run build",
		"changelog":"conventional-changelog -p angular -i CHANGELOG.md -s",
		"preinstall": "npx only-allow pnpm",
		"prepare":"husky",
		"pre-commit":"lint-staged",
		"commit-msg":"tsx scripts/verify-commit-msg.ts"
	},
	"author":"唐国雄",
	"license":"MIT",
	"packageManager":"pnpm@10.15.0",
	"engines":{
		"node":"^22.17.0"
	},
	"lint-staged":{
		"*.{js,ts,vue}":[
			"eslint"
		]
	},
	"devDependencies":{
		"@powerful/eslint-config":"workspace:~",
		"@powerful/utils":"workspace:~",
		"@types/jest":"~30.0.0",
		"@types/node":"~22.17.0",
		"chalk":"~5.4.1",
		"conventional-changelog-cli":"~5.0.0",
		"husky":"~9.1.7",
		"jest":"~30.0.5",
		"jest-environment-jsdom":"~30.0.5",
		"lint-staged":"~16.1.5",
		"ts-jest":"~29.4.1",
		"ts-node":"~10.9.2",
		"tslib":"~2.8.1",
		"tsx":"~4.20.4",
		"typescript":"~5.9.2"
	}
}