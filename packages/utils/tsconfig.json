{
	"compilerOptions":{
		"strict":true,
		"module":"esnext",
		"target":"esnext",
		"moduleResolution":"bundler",
		"allowJs":true,
		"useDefineForClassFields":true,
		"importHelpers":true,
		"resolveJsonModule":true,
		"esModuleInterop":true,
		"baseUrl":".",
		"paths":{
			"@powerful/utils/esm/browser":[
				"src/browser"
			],
			"@powerful/utils/esm/node":[
				"src/node"
			]
		},
		"declaration":false
	},
	"include":[
		"**/*"
	],
	"exclude":[
		"node_modules",
		"lib",
		"dist"
	]
}