{
	"compilerOptions":{
		"strict":true,
		"module":"NodeNext",
		"target":"esnext",
		"moduleResolution":"NodeNext",
		"allowJs":true,
		"useDefineForClassFields":true,
		"importHelpers":true,
		"resolveJsonModule":true,
		"esModuleInterop":true,
		"baseUrl":".",
		"paths":{
		},
		"outDir":"lib",
		"declaration":true,
		"preserveSymlinks":true
	},
	"include":[
		"**/*"
	],
	"exclude":[
		"node_modules",
		"lib"
	]
}