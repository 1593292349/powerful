{
	"type":"module",
	"name":"@powerful/eslint-config",
	"version":"1.0.0-beta.0",
	"description":"eslint共享配置",
	"main":"lib/vue3.js",
	"scripts":{
		"build":"tsc"
	},
	"files":[
		"lib"
	],
	"exports":{
		"./lib/":"./lib/",
		"./vue2":{
			"types":"./lib/vue2.d.ts",
			"default":"./lib/vue2.js"
		},
		"./vue3":{
			"types":"./lib/vue3.d.ts",
			"default":"./lib/vue3.js"
		}
	},
	"repository":{
		"type":"git",
		"url":"https://github.com/1593292349/powerful.git"
	},
	"keywords":[
		"eslint",
		"eslintconfig"
	],
	"author":"唐国雄",
	"license":"MIT",
	"publishConfig":{
		"registry":"https://registry.npmjs.org"
	},
	"dependencies":{
		"@eslint/js":"~9.33.0",
		"@stylistic/eslint-plugin":"~5.2.3",
		"eslint":"~9.33.0",
		"eslint-plugin-vue":"~10.4.0",
		"globals":"~16.3.0",
		"typescript-eslint":"~8.40.0"
	},
	"peerDependencies":{
		"eslint":">= 9"
	}
}